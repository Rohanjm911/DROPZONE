<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DropZone.UI.Views"
        xmlns:vm="using:DropZone.UI.ViewModels"
        x:Class="DropZone.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DROPZONE – Move Files. Not Your Privacy."
        Width="1020" Height="700"
        MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        Background="{DynamicResource DzBgBrush}"
        DragDrop.AllowDrop="True">

  <views:MainView />

</Window>
