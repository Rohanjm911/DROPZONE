<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DropZone.UI.ViewModels"
             x:Class="DropZone.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource DzBgBrush}">

  <Grid RowDefinitions="Auto, *, Auto">

    <!-- TOP TACTICAL HEADER BAR -->
    <Border Grid.Row="0" Background="{DynamicResource DzSidebarBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <!-- Brand / Identity -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource DzPrimaryBrush}" CornerRadius="6" Width="30" Height="30">
            <TextBlock Text="DZ" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Text="DROPZONE" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource DzTextPrimaryBrush}" LetterSpacing="0.8" />
            <TextBlock Text="ZERO-CLOUD SECURE FILE ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.4" />
          </StackPanel>
        </StackPanel>

        <!-- Status & Telemetry Badges -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Port Status -->
          <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource DzSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Text="PORT 52490 ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" LetterSpacing="0.4" />
            </StackPanel>
          </Border>

          <!-- Throughput Meter -->
          <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="THROUGHPUT:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DzTextSecondaryBrush}" />
              <TextBlock Text="{Binding TotalSpeedFormatted}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DzAccentBrush}" />
            </StackPanel>
          </Border>

          <!-- Platform Indicator -->
          <Border Background="{DynamicResource DzSurfaceElevatedBrush}" BorderBrush="{DynamicResource DzBorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
            <TextBlock Text="{Binding PlatformName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- MAIN BODY -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto, *">

      <!-- DESKTOP LEFT NAVIGATION RAIL (Visible on desktop / wide) -->
      <Border Grid.Column="0" Background="{DynamicResource DzSidebarBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="0,0,1,0" Padding="12,16"
              Width="210" IsVisible="{Binding !IsMobile}">
        <Grid RowDefinitions="*, Auto">
          <!-- Navigation Buttons -->
          <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="WORKSPACES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DzTextMutedBrush}" Margin="8,0,0,6" LetterSpacing="1" />

            <!-- Transfers Button -->
            <Button Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Transfers"
                    Background="{Binding IsTransfersTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True}">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="Transfers" FontSize="13" FontWeight="SemiBold" />
                <Border Grid.Column="1" Background="{DynamicResource DzPrimaryBrush}" CornerRadius="10" Padding="7,2" IsVisible="{Binding ActiveTransfers.Count}">
                  <TextBlock Text="{Binding ActiveTransfers.Count}" FontSize="10" Foreground="White" FontWeight="Bold" />
                </Border>
              </Grid>
            </Button>

            <!-- Nearby Devices Button -->
            <Button Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Devices">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="Nearby Devices" FontSize="13" FontWeight="SemiBold" />
                <Border Grid.Column="1" Background="{DynamicResource DzSurfaceElevatedBrush}" BorderBrush="{DynamicResource DzBorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="6,1" IsVisible="{Binding NearbyDevices.Count}">
                  <TextBlock Text="{Binding NearbyDevices.Count}" FontSize="10" Foreground="{DynamicResource DzTextPrimaryBrush}" FontWeight="Bold" />
                </Border>
              </Grid>
            </Button>

            <!-- History Button -->
            <Button Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="History">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="History" FontSize="13" FontWeight="SemiBold" />
                <Border Grid.Column="1" Background="{DynamicResource DzSurfaceBrush}" CornerRadius="10" Padding="6,1" IsVisible="{Binding HistoryTransfers.Count}">
                  <TextBlock Text="{Binding HistoryTransfers.Count}" FontSize="10" Foreground="{DynamicResource DzTextSecondaryBrush}" />
                </Border>
              </Grid>
            </Button>

            <!-- Audit Button -->
            <Button Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Audit">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="Compliance Audit" FontSize="13" FontWeight="SemiBold" />
                <Border Grid.Column="1" Background="{DynamicResource DzSurfaceBrush}" CornerRadius="10" Padding="6,1" IsVisible="{Binding AuditLog.Count}">
                  <TextBlock Text="{Binding AuditLog.Count}" FontSize="10" Foreground="{DynamicResource DzTextSecondaryBrush}" />
                </Border>
              </Grid>
            </Button>

            <!-- Diagnostics Button -->
            <Button Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Diagnostics">
              <TextBlock Text="Diagnostics &amp; NAT" FontSize="13" FontWeight="SemiBold" />
            </Button>

            <!-- Settings Button -->
            <Button Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Settings">
              <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" />
            </Button>
          </StackPanel>

          <!-- Security Assurance Card (Bottom Rail) -->
          <Border Grid.Row="1" Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="SECURITY ASSURANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.8" />
              <TextBlock Text="ChaCha20-Poly1305" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBlock Text="Direct P2P • Zero Relay" FontSize="10" Foreground="{DynamicResource DzTextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- WORKSPACE CONTENT AREA -->
      <Grid Grid.Column="1" Margin="20">

        <!-- 1. TRANSFERS TAB -->
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding IsTransfersTab}">
          <!-- DROP ZONE / FILE PICKER TARGET -->
          <Border Grid.Row="0" Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzPrimaryBrush}" 
                  BorderThickness="2" CornerRadius="10" Padding="24,18" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Direct Secure File Transfer" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                <TextBlock Text="Drag and drop files anywhere into this window, or click Browse to select files." FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <Border Background="{DynamicResource DzSurfaceElevatedBrush}" BorderBrush="{DynamicResource DzBorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="E2EE ENCRYPTED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DzAccentBrush}" LetterSpacing="0.5" />
                  </Border>
                  <Border Background="{DynamicResource DzSurfaceElevatedBrush}" BorderBrush="{DynamicResource DzBorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="SHA-256 VERIFIED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DzSuccessBrush}" LetterSpacing="0.5" />
                  </Border>
                  <Border Background="{DynamicResource DzSurfaceElevatedBrush}" BorderBrush="{DynamicResource DzBorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="ZERO CLOUD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DzWarningBrush}" LetterSpacing="0.5" />
                  </Border>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Classes="Primary" Content="Pick Files to Send" Command="{Binding PickAndSendFilesCommand}"
                        Padding="18,10" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- ACTIVE TRANSFERS LIST -->
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
              <TextBlock Text="ACTIVE TRANSFERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="1" Margin="0,0,0,4" />

              <!-- Empty State -->
              <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28"
                      IsVisible="{Binding !ActiveTransfers.Count}">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                  <TextBlock Text="No active transfers currently running." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DzTextSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Drag and drop any file above or select a discovered peer device to start streaming." FontSize="11" Foreground="{DynamicResource DzTextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- Transfer Cards -->
              <ItemsControl ItemsSource="{Binding ActiveTransfers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TransferItemViewModel">
                    <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                      <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                        <!-- Top Row: File Name & Direction -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding PrimaryFileName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                            <TextBlock Text="{Binding AdditionalFilesLabel}" FontSize="11" Foreground="{DynamicResource DzAccentBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                          </StackPanel>
                          <TextBlock Text="{Binding DirectionLabel, StringFormat='{}{0} '}" FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}">
                            <Run Text="{Binding PeerName}" FontWeight="SemiBold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                          </TextBlock>
                        </StackPanel>

                        <!-- State Badge -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{Binding StateColor}" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
                          <TextBlock Text="{Binding StateBadge}" FontSize="10" FontWeight="Bold" Foreground="White" LetterSpacing="0.5" />
                        </Border>

                        <!-- Middle Row: Progress Bar -->
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="7" Minimum="0" Maximum="100" 
                                     Value="{Binding Progress}" CornerRadius="3" Margin="0,12,0,8"
                                     Foreground="{DynamicResource DzPrimaryBrush}" Background="{DynamicResource DzBorderBrush}" />

                        <!-- Bottom Row: Stats & Controls -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormattedProgress}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                            <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedSpeed}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DzAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedEta}" FontSize="11" Foreground="{DynamicResource DzTextMutedBrush}" VerticalAlignment="Center" />
                          </StackPanel>

                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="Secondary" Content="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" 
                                    FontSize="11" Padding="10,5" CornerRadius="4" />
                            <Button Classes="Primary" Content="Resume" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" 
                                    FontSize="11" Padding="10,5" CornerRadius="4" />
                            <Button Classes="Danger" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" 
                                    FontSize="11" Padding="10,5" CornerRadius="4" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- 2. NEARBY DEVICES TAB -->
        <ScrollViewer IsVisible="{Binding IsDevicesTab}">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Discovered Peers on Local Network (mDNS)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBlock Text="Direct zero-configuration discovery. Devices broadcasting DropZone beacons on your LAN appear automatically." FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />
            </StackPanel>

            <!-- Empty State -->
            <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28"
                    IsVisible="{Binding !NearbyDevices.Count}" Margin="0,8,0,0">
              <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="Scanning for nearby DropZone peers..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DzTextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Ensure other devices are connected to the same Wi-Fi or subnet with DropZone active." FontSize="11" Foreground="{DynamicResource DzTextMutedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- Discovered Devices List -->
            <ItemsControl ItemsSource="{Binding NearbyDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceItemViewModel">
                  <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" 
                          BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                      <!-- Online Status Indicator -->
                      <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,14,0" VerticalAlignment="Center" />

                      <!-- Info -->
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                          <Border Background="{Binding TrustColor}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding TrustBadge}" FontSize="10" FontWeight="Bold" Foreground="White" LetterSpacing="0.4" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}" FontFamily="Consolas, monospace" />
                      </StackPanel>

                      <!-- Action Buttons -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="Secondary" Content="Pair (SAS)" Command="{Binding PairDeviceCommand}" FontSize="11" Padding="10,6" CornerRadius="6" />
                        <Button Classes="Secondary" Content="Toggle Trust" Command="{Binding ToggleTrustCommand}" FontSize="11" Padding="10,6" CornerRadius="6" />
                        <Button Classes="Primary" Content="Send Files" Command="{Binding SendFilesCommand}" FontSize="11" Padding="14,6" CornerRadius="6" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- 3. HISTORY TAB -->
        <ScrollViewer IsVisible="{Binding IsHistoryTab}">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Transfer History &amp; Cryptographic Records" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBlock Text="Persistent local log of verified transfers stored securely in SQLite with SHA-256 chunk validation." FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />
            </StackPanel>

            <!-- Empty State -->
            <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28"
                    IsVisible="{Binding !HistoryTransfers.Count}" Margin="0,8,0,0">
              <TextBlock Text="No past transfers recorded in local database." FontSize="13" Foreground="{DynamicResource DzTextMutedBrush}" HorizontalAlignment="Center" />
            </Border>

            <!-- History Items -->
            <ItemsControl ItemsSource="{Binding HistoryTransfers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferItemViewModel">
                  <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" 
                          BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*, Auto">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="{Binding PrimaryFileName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}" />
                          <TextBlock Text="{Binding DirectionLabel, StringFormat='{}{0} '}" FontSize="11" Foreground="{DynamicResource DzTextMutedBrush}">
                            <Run Text="{Binding PeerName}" FontWeight="SemiBold" Foreground="{DynamicResource DzTextSecondaryBrush}" />
                          </TextBlock>
                          <TextBlock Text="✓ SHA-256 VERIFIED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DzSuccessBrush}" />
                        </StackPanel>
                      </StackPanel>

                      <Border Grid.Column="1" Background="{Binding StateColor}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateBadge}" FontSize="10" FontWeight="Bold" Foreground="White" LetterSpacing="0.4" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- 4. COMPLIANCE AUDIT TAB -->
        <ScrollViewer IsVisible="{Binding IsAuditTab}">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="Cryptographic Compliance Audit Trail" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBlock Text="Immutable SHA-256 hash-chained security event ledger recording all authorizations and transfers." FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />
            </StackPanel>

            <!-- Integrity Verification Banner -->
            <Border Background="{DynamicResource DzSurfaceElevatedBrush}" BorderBrush="{DynamicResource DzBorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
              <Grid ColumnDefinitions="Auto, *">
                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{DynamicResource DzSuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding AuditIntegrityStatus}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource DzSuccessBrush}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- Empty State -->
            <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24"
                    IsVisible="{Binding !AuditLog.Count}">
              <TextBlock Text="Audit ledger is active and monitoring security events." FontSize="12" Foreground="{DynamicResource DzTextMutedBrush}" HorizontalAlignment="Center" />
            </Border>

            <!-- Audit Log Records -->
            <ItemsControl ItemsSource="{Binding AuditLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" 
                          BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                      <Border Grid.Column="0" Background="{DynamicResource DzBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding SequenceNumber, StringFormat='#{0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DzAccentBrush}" FontFamily="Consolas, monospace" />
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding EventType}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                          <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss} UTC'}" FontSize="10" Foreground="{DynamicResource DzTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>

                      <TextBlock Grid.Column="2" Text="{Binding EntryHash}" FontSize="10" Foreground="{DynamicResource DzTextMutedBrush}" FontFamily="Consolas, monospace" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- 5. DIAGNOSTICS & TELEMETRY TAB -->
        <ScrollViewer IsVisible="{Binding IsDiagnosticsTab}">
          <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
              <TextBlock Text="Network Telemetry &amp; System Diagnostics" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBlock Text="Real-time link measurement, adaptive chunk sizing metrics, and encrypted vault backups." FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />
            </StackPanel>

            <!-- Real-Time Link Telemetry KPI Cards -->
            <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Grid.Column="0" Text="LIVE CONNECTION &amp; ADAPTIVE LINK" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.8" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="Secondary" Content="Ping Selected Peer" Command="{Binding PingSelectedDeviceCommand}" FontSize="11" Padding="10,5" CornerRadius="4" />
                </Grid>

                <Grid ColumnDefinitions="*, *, *" Margin="0,4,0,0">
                  <Border Grid.Column="0" Background="{DynamicResource DzBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                    <StackPanel Spacing="4">
                      <TextBlock Text="ROUTE MODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.6" />
                      <TextBlock Text="{Binding ActiveRouteFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DzAccentBrush}" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Background="{DynamicResource DzBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                    <StackPanel Spacing="4">
                      <TextBlock Text="RTT LATENCY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.6" />
                      <TextBlock Text="{Binding LatencyFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DzSuccessBrush}" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Background="{DynamicResource DzBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                    <StackPanel Spacing="4">
                      <TextBlock Text="CHUNK SIZE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.6" />
                      <TextBlock Text="{Binding ActiveChunkSizeFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Encrypted Backup Card -->
            <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="ENCRYPTED AUDIT &amp; PAIRING BACKUP" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.8" />
                <TextBlock Text="PBKDF2 (100,000 iterations) + AES-256-GCM encrypted backup vault (.dzbackup)." FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}" />

                <StackPanel Spacing="4">
                  <TextBlock Text="Passphrase:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                  <TextBox x:Name="BackupPassphraseBox" PasswordChar="•" Watermark="Enter secure passphrase..." Background="{DynamicResource DzBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" CornerRadius="6" Padding="10,8" />
                </StackPanel>

                <Button Classes="Primary" Content="Export Encrypted Backup (.dzbackup)" Click="OnExportBackupClick"
                        FontSize="11" Padding="14,8" CornerRadius="6" HorizontalAlignment="Left" />

                <TextBlock Text="{Binding BackupStatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DzSuccessBrush}" TextWrapping="Wrap" IsVisible="{Binding BackupStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 6. SETTINGS TAB -->
        <ScrollViewer IsVisible="{Binding IsSettingsTab}">
          <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
              <TextBlock Text="Application Settings &amp; Security" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBlock Text="Configure local device identity, download storage paths, and NAT discovery." FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />
            </StackPanel>

            <!-- Device Name -->
            <StackPanel Spacing="4">
              <TextBlock Text="Device Name (Broadcasted on LAN)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBox Text="{Binding DeviceName}" Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" CornerRadius="6" Padding="10,8" />
            </StackPanel>

            <!-- Download Location -->
            <StackPanel Spacing="4">
              <TextBlock Text="Download Directory" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
              <TextBox Text="{Binding DownloadPath}" IsReadOnly="True" Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" CornerRadius="6" Padding="10,8" />
            </StackPanel>

            <!-- Security Toggles -->
            <StackPanel Spacing="8" Margin="0,4,0,0">
              <CheckBox IsChecked="{Binding AutoAcceptTrusted}" Content="Auto-accept incoming transfers from Trusted Devices" FontSize="12" Foreground="{DynamicResource DzTextPrimaryBrush}" />
            </StackPanel>

            <!-- Network Diagnostics Panel -->
            <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Grid.Column="0" Text="STUN &amp; NAT TRAVERSAL DIAGNOSTICS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DzTextMutedBrush}" LetterSpacing="0.8" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="Secondary" Content="Probe STUN" Command="{Binding RunNetworkDiagnosticsCommand}" FontSize="11" Padding="10,5" CornerRadius="4" />
                </Grid>
                <StackPanel Spacing="2">
                  <TextBlock Text="Reflexive Public Endpoint:" FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}" />
                  <TextBlock Text="{Binding PublicEndpointFormatted}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DzAccentBrush}" FontFamily="Consolas, monospace" />
                </StackPanel>
                <TextBlock Text="{Binding NatDiagnosticsStatus}" FontSize="11" Foreground="{DynamicResource DzTextMutedBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- INCOMING TRANSFER APPROVAL DIALOG OVERLAY -->
        <Border Background="#E0000000" IsVisible="{Binding HasIncomingRequest}" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" 
                  CornerRadius="10" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14">
              <TextBlock Text="INCOMING TRANSFER REQUEST" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" LetterSpacing="0.6" />
              <TextBlock Text="{Binding IncomingRequest.SenderDeviceName, StringFormat='Device &quot;{0}&quot; wants to send you files.'}" FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />

              <!-- Suspicious Files Warning Banner -->
              <Border Background="#3B1212" BorderBrush="{DynamicResource DzDangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12" 
                      IsVisible="{Binding HasSuspiciousFilesInIncoming}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding SuspiciousWarningMessage}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DzDangerBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="These files may execute code or contain disguised extensions. DropZone never executes received files automatically." 
                             FontSize="10" Foreground="{DynamicResource DzTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource DzBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding IncomingRequest.FileCount, StringFormat='Files count: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DzTextPrimaryBrush}" />
                  <TextBlock Text="{Binding IncomingRequest.TotalBytes, StringFormat='Total size: {0} bytes'}" FontSize="11" Foreground="{DynamicResource DzTextSecondaryBrush}" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                <Button Grid.Column="0" Classes="Danger" Content="Decline" Command="{Binding RejectIncomingCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0" Padding="10,8" CornerRadius="6" />
                <Button Grid.Column="1" Classes="Primary" Content="Approve Transfer" Command="{Binding ApproveIncomingCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0" Padding="10,8" CornerRadius="6" />
              </Grid>
            </StackPanel>
          </Border>
        </Border>

        <!-- CRYPTOGRAPHIC PAIRING MODAL OVERLAY -->
        <Border Background="#E6000000" IsVisible="{Binding HasPairingRequest}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Border Background="{DynamicResource DzSurfaceBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" 
                  CornerRadius="10" Padding="24" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <StackPanel Spacing="2">
                <TextBlock Text="DEVICE PAIRING &amp; AUTHENTICATION" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DzTextPrimaryBrush}" LetterSpacing="0.6" />
                <TextBlock Text="{Binding PairingPeerName, StringFormat='Verifying secure identity with &quot;{0}&quot;'}" FontSize="12" Foreground="{DynamicResource DzTextSecondaryBrush}" />
              </StackPanel>

              <Border Background="{DynamicResource DzBgBrush}" BorderBrush="{DynamicResource DzPrimaryBrush}" BorderThickness="2" CornerRadius="8" Padding="18,14">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="CONFIRMATION PIN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DzTextSecondaryBrush}" HorizontalAlignment="Center" LetterSpacing="1" />
                  <TextBlock Text="{Binding PairingPinFormatted}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource DzAccentBrush}" HorizontalAlignment="Center" LetterSpacing="6" />
                  <TextBlock Text="Verify that this exact 6-digit PIN matches on both devices." FontSize="10" Foreground="{DynamicResource DzTextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource DzSidebarBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Fingerprint:" FontSize="10" Foreground="{DynamicResource DzTextMutedBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PairingFingerprint}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DzTextPrimaryBrush}" FontFamily="Consolas, monospace" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                <Button Grid.Column="0" Classes="Secondary" Content="Reject" Command="{Binding RejectPairingCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0" Padding="10,8" CornerRadius="6" />
                <Button Grid.Column="1" Classes="Success" Content="Confirm Match" Command="{Binding ConfirmPairingCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0" Padding="10,8" CornerRadius="6" />
              </Grid>
            </StackPanel>
          </Border>
        </Border>

      </Grid>
    </Grid>

    <!-- MOBILE BOTTOM NAVIGATION BAR (Visible on mobile / compact) -->
    <Border Grid.Row="2" Background="{DynamicResource DzSidebarBgBrush}" BorderBrush="{DynamicResource DzBorderBrush}" BorderThickness="0,1,0,0" Padding="6,6"
            IsVisible="{Binding IsMobile}">
      <Grid ColumnDefinitions="*, *, *, *, *, *">
        <Button Grid.Column="0" Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Transfers"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" CornerRadius="6">
          <TextBlock Text="Transfers" FontSize="10" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="1" Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Devices"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" CornerRadius="6">
          <TextBlock Text="Devices" FontSize="10" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="2" Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="History"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" CornerRadius="6">
          <TextBlock Text="History" FontSize="10" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="3" Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Audit"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" CornerRadius="6">
          <TextBlock Text="Audit" FontSize="10" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="4" Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Diagnostics"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" CornerRadius="6">
          <TextBlock Text="Diag" FontSize="10" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="5" Classes="NavBtn" Command="{Binding SwitchTabCommand}" CommandParameter="Settings"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8" CornerRadius="6">
          <TextBlock Text="Settings" FontSize="10" FontWeight="SemiBold" />
        </Button>
      </Grid>
    </Border>

  </Grid>
</UserControl>
