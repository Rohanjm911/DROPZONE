<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Stealth Obsidian Dark Theme Palette (Solid Colors, Zero Gradients) -->
    <Color x:Key="DzBgColor">#090D16</Color>
    <SolidColorBrush x:Key="DzBgBrush" Color="{StaticResource DzBgColor}" />

    <Color x:Key="DzSidebarBgColor">#0B1120</Color>
    <SolidColorBrush x:Key="DzSidebarBgBrush" Color="{StaticResource DzSidebarBgColor}" />

    <Color x:Key="DzSurfaceColor">#0F172A</Color>
    <SolidColorBrush x:Key="DzSurfaceBrush" Color="{StaticResource DzSurfaceColor}" />

    <Color x:Key="DzSurfaceHoverColor">#1E293B</Color>
    <SolidColorBrush x:Key="DzSurfaceHoverBrush" Color="{StaticResource DzSurfaceHoverColor}" />

    <Color x:Key="DzSurfaceElevatedColor">#162032</Color>
    <SolidColorBrush x:Key="DzSurfaceElevatedBrush" Color="{StaticResource DzSurfaceElevatedColor}" />

    <Color x:Key="DzBorderColor">#1E293B</Color>
    <SolidColorBrush x:Key="DzBorderBrush" Color="{StaticResource DzBorderColor}" />

    <Color x:Key="DzBorderLightColor">#334155</Color>
    <SolidColorBrush x:Key="DzBorderLightBrush" Color="{StaticResource DzBorderLightColor}" />

    <Color x:Key="DzTextPrimaryColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="DzTextPrimaryBrush" Color="{StaticResource DzTextPrimaryColor}" />

    <Color x:Key="DzTextSecondaryColor">#94A3B8</Color>
    <SolidColorBrush x:Key="DzTextSecondaryBrush" Color="{StaticResource DzTextSecondaryColor}" />

    <Color x:Key="DzTextMutedColor">#64748B</Color>
    <SolidColorBrush x:Key="DzTextMutedBrush" Color="{StaticResource DzTextMutedColor}" />
  </Styles.Resources>

  <!-- Navigation Rail Button Style -->
  <Style Selector="Button.NavBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DzTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.NavBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DzSurfaceHoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource DzTextPrimaryBrush}" />
  </Style>

  <!-- Primary Tactical Accent Button -->
  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource DzPrimaryBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DzPrimaryHoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.Primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DzPrimaryPressedBrush}" />
    <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Secondary Slate Outlined Button -->
  <Style Selector="Button.Secondary">
    <Setter Property="Background" Value="{DynamicResource DzSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DzTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DzBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DzSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DzBorderLightBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource DzTextPrimaryBrush}" />
  </Style>

  <!-- Danger Crimson Button -->
  <Style Selector="Button.Danger">
    <Setter Property="Background" Value="{DynamicResource DzDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#DC2626" />
    <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Success Emerald Button -->
  <Style Selector="Button.Success">
    <Setter Property="Background" Value="{DynamicResource DzSuccessBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.Success:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#059669" />
    <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
  </Style>

</Styles>
