<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DropZone.Domain\DropZone.Domain.csproj" />
  </ItemGroup>

  <!-- Automatically copy native dropzone_engine binaries to output if present -->
  <Target Name="CopyNativeEngine" AfterTargets="Build">
    <ItemGroup>
      <NativeEngineRelease Include="$(MSBuildThisFileDirectory)..\..\engine\target\release\dropzone_engine.dll" />
      <NativeEngineDebug Include="$(MSBuildThisFileDirectory)..\..\engine\target\debug\dropzone_engine.dll" />
      <NativeEngineLinux Include="$(MSBuildThisFileDirectory)..\..\engine\target\release\libdropzone_engine.so" />
      <NativeEngineMac Include="$(MSBuildThisFileDirectory)..\..\engine\target\release\libdropzone_engine.dylib" />
    </ItemGroup>

    <Copy SourceFiles="@(NativeEngineRelease)" DestinationFolder="$(TargetDir)" Condition="Exists('@(NativeEngineRelease)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeEngineLinux)" DestinationFolder="$(TargetDir)" Condition="Exists('@(NativeEngineLinux)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeEngineMac)" DestinationFolder="$(TargetDir)" Condition="Exists('@(NativeEngineMac)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
