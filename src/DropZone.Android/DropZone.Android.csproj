<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Build as net11.0-android when Android workload is present; otherwise net11.0 for portable validation -->
    <TargetFramework Condition="'$(TargetPlatformIdentifier)' == 'android'">net11.0-android</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DropZone.Android</RootNamespace>
    <AssemblyName>DropZone.Android</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DropZone.Domain\DropZone.Domain.csproj" />
    <ProjectReference Include="..\DropZone.Application\DropZone.Application.csproj" />
    <ProjectReference Include="..\DropZone.Infrastructure\DropZone.Infrastructure.csproj" />
    <ProjectReference Include="..\DropZone.Engine.Interop\DropZone.Engine.Interop.csproj" />
    <ProjectReference Include="..\DropZone.UI\DropZone.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

</Project>
